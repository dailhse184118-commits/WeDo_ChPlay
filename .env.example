# Sao chép file này thành .env rồi điền giá trị thật.
# .env nằm trong .gitignore và không bao giờ được commit.

EXPO_PUBLIC_API_BASE_URL=https://your-api-host.example.com

# OAuth client dạng **Web** của project Google Cloud `alert-rush-501204-b6`.
# Không phải bí mật: client ID Web luôn lộ ra ở phía trình duyệt. Để trống cũng
# chạy được — `src/lib/auth/google-signin.ts` có sẵn giá trị dự phòng y hệt.
#
# Hai client dạng Android (khoá tải lên EAS và khoá ký của Play) KHÔNG khai ở
# đây; chúng chỉ tồn tại phía Google để cho phép gói vn.wedo.app xin token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=108450458549-b3g83it3kjnpihupihmj9kvd23fj8am3.apps.googleusercontent.com
