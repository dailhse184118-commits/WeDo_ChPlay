{
  "expo": {
    "name": "WeDo",
    "slug": "wedo",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wedo",
    "userInterfaceStyle": "light",
    "locales": {
      "vi": "./locales/vi.json"
    },
    "ios": {
      "bundleIdentifier": "vn.wedo.app",
      "buildNumber": "3",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "vi",
        "CFBundleLocalizations": ["vi"],
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "vn.wedo.app",
      "versionCode": 19,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0055c7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0055c7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0055c7"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.108450458549-jr95oi462iueau8md2n4vp2di1b47pmn"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "cameraPermission": "WeDo cần máy ảnh để bạn chụp và gửi ảnh ngay trong khung chat.",
          "photosPermission": "WeDo cần thư viện ảnh để bạn gửi ảnh có sẵn trong khung chat và chọn ảnh đại diện.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-may-anh-tuy-chon"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69dcbb1c-23f5-47ea-9f56-4a555d4f5a23"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/69dcbb1c-23f5-47ea-9f56-4a555d4f5a23"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
